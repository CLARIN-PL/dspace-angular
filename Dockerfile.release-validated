ARG VALIDATED_IMAGE=clarin-pl/dspace-angular:ssr-bundle-selection-20261028
FROM ${VALIDATED_IMAGE} AS validated
FROM node:22.23.4-alpine
WORKDIR /app
COPY --chown=node:node --from=validated /app/dist /app/dist
COPY --chown=node:node config /app/config
COPY --chown=node:node docker/dspace-ui.json /app/dspace-ui.json
RUN find /app/dist -type f -name '*.map' -delete
ENV NODE_ENV=production
USER node
EXPOSE 4000
CMD ["node", "dist/server/main.js"]
