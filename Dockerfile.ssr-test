# Local-only test build. Reuse dependencies only when yarn.lock matches this image.
ARG DEPENDENCIES_IMAGE=clarin-pl/dspace-angular:anchor-navigation-check
FROM ${DEPENDENCIES_IMAGE} AS dependencies

FROM node:22.23.4-alpine AS testbase
WORKDIR /app
COPY --from=dependencies /app/node_modules /app/node_modules
COPY --from=dependencies /app/dist /app/dist
COPY . /app
ENV NODE_OPTIONS=--max-old-space-size=4096
ENV NG_CLI_ANALYTICS=false
ENV TS_NODE_PROJECT=tests/server/tsconfig.json

FROM testbase AS compiled
# Source maps are for isolated diagnosis; this is not the production image.
ENV DSPACE_UI_NAMESPACE=/dspace
ENV NODE_ENV=production
RUN ./node_modules/.bin/ts-node --project tsconfig.ts-node.json scripts/base-href.ts \
    && ./node_modules/.bin/ng build --configuration production \
    && ./node_modules/.bin/ng run dspace-angular:server:production --source-map=true
COPY src/static-files /app/dist/browser/static-files
CMD ["node", "dist/server/main.js"]
