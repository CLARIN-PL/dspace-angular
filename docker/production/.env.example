# Generated values are written to .env by ./manage.sh init.
COMPOSE_PROJECT_NAME=clarin-pl-dspace

# Public single-origin URL. For a real deployment, terminate TLS in front of
# this stack and update all four REST/PUBLIC settings together.
PUBLIC_URL=http://localhost:4000
REST_SSL=false
REST_HOST=localhost
REST_PORT=4000
HTTP_BIND=127.0.0.1
HTTP_PORT=4000

TIMEZONE=Europe/Warsaw
DSPACE_NAME="CLARIN-PL Repository"
JAVA_OPTS="-Xms1g -Xmx4g"
SOLR_HEAP=2g

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_LOGIN_SECRET=__JWT_LOGIN_SECRET__
JWT_SHORT_LIVED_SECRET=__JWT_SHORT_LIVED_SECRET__
CLARIN_TOKEN_ENCRYPTION_SECRET=__CLARIN_TOKEN_ENCRYPTION_SECRET__

ADMIN_EMAIL=admin@localhost
ADMIN_FIRST_NAME=Local
ADMIN_LAST_NAME=Administrator
ADMIN_PASSWORD=__ADMIN_PASSWORD__
