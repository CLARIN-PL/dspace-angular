# Generated values are written to .env by ./manage.sh init.
COMPOSE_PROJECT_NAME=clarin-pl-dspace

# Public single-origin URL. For a real deployment, terminate TLS in front of
# this stack and update all four REST/PUBLIC settings together.
PUBLIC_URL=http://localhost:4000
REST_SSL=false
REST_HOST=localhost
REST_PORT=4000
HTTP_BIND=127.0.0.1
HTTP_PORT=4000

TIMEZONE=Europe/Warsaw
DSPACE_NAME="CLARIN-PL Repository"
JAVA_OPTS="-Xms1g -Xmx4g"
SOLR_HEAP=2g

# Persistent repository data. This is a bind mount on purpose: the 637 GB
# legacy assetstore remains in place and is not copied into a Docker volume.
DSPACE_ASSETSTORE_PATH=/media/tomasz/61a05882-c126-4df8-bb14-228582bd35cd/dspace/assetstore

# Persistent identifiers migrated from the old CLARIN-PL repository.
HANDLE_PREFIX=11321
HANDLE_CANONICAL_PREFIX=https://hdl.handle.net/

# Keep disabled throughout migration. Enable only after SMTP has been tested
# with a sink/test mailbox and the migration has passed validation.
MAIL_SERVER_DISABLED=true
MAIL_SERVER=clarinpl.nazwa.pl
MAIL_SERVER_PORT=587
MAIL_SERVER_USERNAME=dspace@clarin-pl.eu
MAIL_SERVER_PASSWORD=
MAIL_FROM_ADDRESS=dspace@clarin-pl.eu
MAIL_ADMIN=admin@clarin-pl.eu
FEEDBACK_RECIPIENT=dspace@clarin-pl.eu
REGISTRATION_NOTIFY=dspace@clarin-pl.eu

# Password login remains available for the migration administrator. Enabling
# Shibboleth additionally requires a configured SP proxy and its private key.
AUTHENTICATION_METHODS=org.dspace.authenticate.PasswordAuthentication
SHIBBOLETH_LOGIN_URL=/Shibboleth.sso/Login
SHIBBOLETH_NETID_HEADERS=eppn,persistent-id
SHIBBOLETH_EMAIL_HEADER=mail
SHIBBOLETH_FIRSTNAME_HEADER=givenName
SHIBBOLETH_LASTNAME_HEADER=sn
SHIBBOLETH_AUTOREGISTER=true

POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
JWT_LOGIN_SECRET=__JWT_LOGIN_SECRET__
JWT_SHORT_LIVED_SECRET=__JWT_SHORT_LIVED_SECRET__
CLARIN_TOKEN_ENCRYPTION_SECRET=__CLARIN_TOKEN_ENCRYPTION_SECRET__

ADMIN_EMAIL=admin@localhost
ADMIN_FIRST_NAME=Local
ADMIN_LAST_NAME=Administrator
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# Isolated DSpace 5 databases used only by the migration profile.
LEGACY_DB_PASSWORD=__LEGACY_DB_PASSWORD__
LEGACY_DSPACE_DUMP="/media/tomasz/61a05882-c126-4df8-bb14-228582bd35cd/Backup_2026/Backup/dspace/backup_db 17_2_2026/dspace"
LEGACY_UTILITIES_DUMP="/media/tomasz/61a05882-c126-4df8-bb14-228582bd35cd/Backup_2026/Backup/dspace/backup_db 17_2_2026/dspace_utilities"
